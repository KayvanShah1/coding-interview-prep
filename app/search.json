---
layout: null
---
[
{% assign subject_pages = site.pages
  | where_exp: 'item', 'item.subject != nil'
  | where_exp: 'item', 'item.subject != "home"'
-%}
{%- assign lessons = site.sql | concat: subject_pages | sort: 'sequence' -%}
{%- for lesson in lessons -%}
  {"title":{{ lesson.title | jsonify }},"chapter":{{ lesson.chapter | jsonify }},"description":
  {{- lesson.description | default: '' | jsonify -}}
  ,"url":{{ lesson.url | relative_url | jsonify }},"content":
  {{-
    lesson.content
    | markdownify
    | replace: '<select', '<!--<select'
    | replace: '</select>', '</select>-->'
    | replace: '</', ' </'
    | strip_html
    | normalize_whitespace
    | jsonify
  -}}
  }{% unless forloop.last %},{% endunless -%}
{%- endfor %}
]
